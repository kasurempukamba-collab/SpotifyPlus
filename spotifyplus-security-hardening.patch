+function Get-Sha256Hex {
+    <#
+        Returns the lowercase hex SHA-256 digest of the given bytes.
+    #>
+    param (
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyCollection()]
+        [byte[]]$Bytes
+    )
+
+    $sha256 = [System.Security.Cryptography.SHA256]::Create()
+    try {
+        $hashBytes = $sha256.ComputeHash($Bytes)
+        $sb = [System.Text.StringBuilder]::new($hashBytes.Length * 2)
+        foreach ($b in $hashBytes) {
+            [void]$sb.Append($b.ToString('x2'))
+        }
+        return $sb.ToString()
+    }
+    finally {
+        $sha256.Dispose()
+    }
+}
+
+function Assert-TrustedResource {
+    <#
+        Verifies that bytes downloaded from this repository match the SHA-256
+        pinned in $script:IntegrityManifest for $RelativePath. Returns $true
+        when the content is trusted and safe to execute/inject/parse, $false
+        otherwise. Callers MUST treat a $false return as fatal for that
+        resource and MUST NOT execute, inject, or parse $Bytes in that case.
+
+        $RelativePath must match a key of $script:IntegrityManifest exactly
+        (repository-relative path, forward slashes, no leading slash).
+    #>
+    param (
+        [Parameter(Mandatory = $true)]
+        [string]$RelativePath,
+
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyCollection()]
+        [byte[]]$Bytes
+    )
+
+    $expected = $script:IntegrityManifest[$RelativePath]
+
+    if (-not $expected) {
+        Write-Host "SECURITY: '$RelativePath' has no entry in the integrity manifest embedded in this copy of run.ps1." -ForegroundColor Red
+        Write-Host "This copy of SpotifyPlus does not know this file and will not execute, inject, or parse it." -ForegroundColor Red
+        Write-Host "This is expected right after a new file is added upstream and can mean you simply need the latest run.ps1: https://github.com/kasurempukamba-collab/SpotifyPlus" -ForegroundColor Red
+        return $false
+    }
+
+    $actual = Get-Sha256Hex -Bytes $Bytes
+
+    if ($actual -ne $expected) {
+        Write-Host "SECURITY: integrity check failed for '$RelativePath'." -ForegroundColor Red
+        Write-Host "  Expected SHA-256: $expected" -ForegroundColor Red
+        Write-Host "  Actual   SHA-256: $actual" -ForegroundColor Red
+        Write-Host "The file currently served by the SpotifyPlus repository no longer matches the version that was reviewed and pinned when this copy of run.ps1 was released." -ForegroundColor Red
+        Write-Host "This can simply mean the repository has moved on since your copy of run.ps1 was downloaded (get the latest run.ps1), or it can mean the file was tampered with in transit or on the server." -ForegroundColor Red
+        Write-Host "For your safety, SpotifyPlus will not execute, inject, or use this file. Get the latest run.ps1 from https://github.com/kasurempukamba-collab/SpotifyPlus and try again." -ForegroundColor Red
+        return $false
+    }
+
+    return $true
+}
+
+function Get-RawBytesOrNull {
+    <#
+        Minimal, dependency-free raw byte downloader. Used only by code that
+        runs before the retrying Get() helper (defined further below) exists
+        yet, such as CallLang. Returns $null on any failure instead of
+        throwing, so callers can produce their own clear error message (the
+        language table is not loaded yet this early in the script, so error
+        text here cannot be localized).
+    #>
+    param (
+        [Parameter(Mandatory = $true)]
+        [string]$Url
+    )
+
+    $webClient = New-Object System.Net.WebClient
+    try {
+        return $webClient.DownloadData($Url)
+    }
+    catch {
+        return $null
+    }
+    finally {
+        $webClient.Dispose()
+    }
+}
