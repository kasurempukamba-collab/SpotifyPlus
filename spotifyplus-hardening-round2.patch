@@ -0,0 +1,67 @@
+name: PowerShell lint
+
+on:
+  push:
+    paths:
+      - '**/*.ps1'
+      - '.github/workflows/lint.yml'
+  pull_request:
+    paths:
+      - '**/*.ps1'
+      - '.github/workflows/lint.yml'
+  workflow_dispatch: {}
+
+# Read-only: this job only analyzes files and writes to the job summary, it
+# never pushes, comments, or touches issues/PRs.
+permissions:
+  contents: read
+
+jobs:
+  psscriptanalyzer:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+
+      - name: Run PSScriptAnalyzer
+        shell: pwsh
+        run: |
+          Install-Module -Name PSScriptAnalyzer -Force -Scope CurrentUser -ErrorAction Stop
+
+          $files = Get-ChildItem -Path . -Filter *.ps1 -Recurse -File
+          Write-Host "Analyzing $($files.Count) PowerShell file(s)."
+
+          $results = @()
+          foreach ($file in $files) {
+              $results += Invoke-ScriptAnalyzer -Path $file.FullName -Severity Error, Warning
+          }
+
+          $summaryPath = $env:GITHUB_STEP_SUMMARY
+          "## PSScriptAnalyzer results" | Out-File -FilePath $summaryPath -Append -Encoding utf8
+
+          if ($results.Count -eq 0) {
+              Write-Host 'No findings.'
+              'No findings.' | Out-File -FilePath $summaryPath -Append -Encoding utf8
+              exit 0
+          }
+
+          $results |
+              Sort-Object Severity, ScriptName, Line |
+              Format-Table -AutoSize -Property Severity, RuleName, ScriptName, Line, Message |
+              Out-String -Width 220 |
+              Tee-Object -Variable tableText |
+              Out-Host
+
+          '```' | Out-File -FilePath $summaryPath -Append -Encoding utf8
+          $tableText | Out-File -FilePath $summaryPath -Append -Encoding utf8
+          '```' | Out-File -FilePath $summaryPath -Append -Encoding utf8
+
+          $errorCount = @($results | Where-Object { $_.Severity -eq 'Error' }).Count
+          $warningCount = @($results | Where-Object { $_.Severity -eq 'Warning' }).Count
+          Write-Host "$errorCount error(s), $warningCount warning(s)."
+
+          # Intentionally does not exit 1: this job is currently report-only
+          # while a first baseline of existing findings gets triaged. Once
+          # the codebase is clean (or findings are explicitly suppressed
+          # with justification), change this to fail on $errorCount -gt 0.
